OPENAI_API_KEY=your-openai-api-key
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
TELEGRAM_TOKEN=
TELEGRAM_ALLOWED_USERS=123456789,987654321
WORKERS=3

# Shared secret used only between containers. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Telegram Local Bot API (removes 20MB download limit)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_API_URL=http://telegram-bot-api:8081

# Telegram chats for Discord recording fallback (when file > 25MB)
TELEGRAM_FALLBACK_CHATS=
